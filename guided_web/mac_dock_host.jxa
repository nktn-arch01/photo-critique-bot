// Stay-open applet. Dock に残る。画面はブラウザ。埋め込み描画はしない。

ObjC.import('Foundation');

var gServer = null;

function repoRoot() {
  var bundlePath = ObjC.unwrap($.NSBundle.mainBundle.bundlePath);
  return bundlePath.replace(/\/[^/]+\.app\/?$/, '');
}

function run() {
  var root = repoRoot();
  var script = root + '/scripts/run_guided_app.sh';
  var task = $.NSTask.alloc.init;
  task.setLaunchPath('/bin/bash');
  task.setArguments($.NSArray.arrayWithArray([script, '--server-only']));
  task.setCurrentDirectoryPath(root);
  var env = $.NSMutableDictionary.dictionaryWithDictionary(
    $.NSProcessInfo.processInfo.environment
  );
  env.setObjectForKey('1', 'GUIDED_SERVER_ONLY');
  env.setObjectForKey(root, 'GUIDED_APP_ROOT');
  env.removeObjectForKey('GUIDED_APP_LOGIN');
  task.setEnvironment(env);
  task.launch();
  gServer = task;
}

function quit() {
  try {
    if (gServer) {
      gServer.terminate();
    }
  } catch (e) {}
}
