#!/bin/bash
# LuminaNotesGuided.app の入口。ターミナルは出さない。
# リポジトリ内でもアプリケーションフォルダでも同じ。プログラム置き場は ~/.lumina_notes/guided_root。
# Finder 起動は Terminal/.command と違い .zshrc を読まないので、ログイン殻で本体を呼ぶ。
export PATH="/Library/Frameworks/Python.framework/Versions/Current/bin:/usr/local/bin:/opt/homebrew/bin:${HOME}/.pyenv/shims:${PATH}"
export PYTHONUNBUFFERED=1

APP_BIN="$(cd "$(dirname "$0")" && pwd)"
THIS_APP="$(cd "${APP_BIN}/../.." && pwd)"
# shellcheck source=../Resources/guided_root.sh
source "${APP_BIN}/../Resources/guided_root.sh"

BUNDLE_PARENT="$(cd "${THIS_APP}/.." && pwd)"
if ! guided_root_resolve "$BUNDLE_PARENT"; then
  osascript -e 'display dialog "プログラムのフォルダ（photo-critique-bot）が見つかりません。ターミナルで bash scripts/install_guided_app.sh を実行してから、アプリケーションの Lumina Notes Guided を開いてください。" buttons {"OK"} default button 1 with title "Lumina Notes Guided"' >/dev/null 2>&1 || true
  exit 1
fi
ROOT="$GUIDED_APP_ROOT"
export GUIDED_APP_ROOT="$ROOT"
export GUIDED_APP_LOGIN=1

if guided_root_should_handoff "$THIS_APP" "$ROOT"; then
  exec "${ROOT}/LuminaNotesGuided.app/Contents/MacOS/LuminaNotesGuided"
fi

cd "$ROOT" || exit 1

xattr -dr com.apple.quarantine "${ROOT}/LuminaNotesGuided.app" 2>/dev/null || true

mkdir -p "${HOME}/.lumina_notes"
LOG="${HOME}/.lumina_notes/guided-app.log"
{
  echo "=== Lumina Notes Guided.app $(date) ==="
  echo "ROOT=${ROOT}"
  echo "THIS_APP=${THIS_APP}"
  echo "PATH=${PATH}"
} >>"${LOG}"

osascript -e 'display notification "起動しています。数秒待ってください。" with title "Lumina Notes Guided"' >/dev/null 2>&1 || true

exec >>"${LOG}" 2>&1
export ZSH_DISABLE_COMPFIX=true
if command -v zsh >/dev/null 2>&1; then
  exec zsh -lc 'source "$HOME/.zprofile" >/dev/null 2>&1 || true; source "$HOME/.zshrc" >/dev/null 2>&1 || true; cd "$GUIDED_APP_ROOT" && exec bash "$GUIDED_APP_ROOT/scripts/run_guided_app.sh"'
fi
exec bash "${ROOT}/scripts/run_guided_app.sh"
